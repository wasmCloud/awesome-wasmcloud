package example:component-fault-probe@0.1.0;
world component-fault-probe {
    import wasi:clocks/monotonic-clock@0.3.0;
    import wasmcloud:couchbase/document-read@0.3.0;
    import wasmcloud:couchbase/document-write@0.3.0;
    import wasmcloud:couchbase/sqlpp@0.3.0;
    export wasi:http/handler@0.3.0;
}

/// A caller whose only database capability is reading documents.
world couchbase-read-only {
    import wasmcloud:couchbase/document-read@0.3.0;
    export wasi:http/handler@0.3.0;
}
