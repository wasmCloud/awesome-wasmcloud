    "contracts": {
      "couchbase-wit": ["types", "sqlpp-types", "document-read", "document-write", "sqlpp"]
    },
    "exports": ["wasmcloud:host/workload-lifecycle@0.1.6"],
    "forbiddenImports": ["wasi:tls/client@0.3.0-draft"],
    "license": "Apache-2.0"
  },
  {
    "id": "couchbase-wasi-sockets-p3-tls",
    "kind": "component",
