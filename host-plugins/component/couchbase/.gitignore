# The repository root ignores `.wash/` because it is usually scratch state, but
# this project's build configuration lives there: `.wash/config.yaml` carries
# the WIT source overrides and the build command, so a checkout without it does
# not build. Re-include the directory first — git cannot re-include a file whose
# parent directory is excluded — and then the one file that belongs in git.
!.wash/
.wash/*
!.wash/config.yaml

# Fetched by `wash wit fetch` from the registries pinned in wkg.lock, plus the
# local overrides in .wash/config.yaml. Regenerated by `wash build`.
wit/deps/

# The verification workload's own fetched deps and build state; see
# verification/README.md for what it is and how to run it.
verification/scenario/wit/deps/
verification/scenario/Cargo.lock
